+#if VTE_GTK == 4
+bool
+DrawingContext::get_symbol_metrics(vteunistr c, uint32_t attr, SymbolMetrics& metrics)
+{
+        auto const base = _vte_unistr_get_base(c);
+        // Single text symbols only. Keep clusters, emoji, CJK, letters and
+        // joined Powerline separators on their ordinary rendering paths.
+        if (c != base || (base >= 0xe0a0 && base <= 0xe0d7))
+                return false;
+        auto const private_use = (base >= 0xe000 && base <= 0xf8ff) ||
+                                 (base >= 0xf0000 && base <= 0xffffd) ||
+                                 (base >= 0x100000 && base <= 0x10fffd);
+        auto const text_symbol = base == 0x2026 ||
+                                 (base >= 0x2190 && base <= 0x2199) ||
+                                 (base >= 0x231c && base <= 0x231f) ||
+                                 base == 0x2699 ||
+                                 (base >= 0x27f0 && base <= 0x27ff) ||
+                                 base == 0x2e3a || base == 0x2e3b;
+        if (!private_use && !text_symbol)
+                return false;
+        auto const info = m_fonts[attr_to_style(attr)]->get_unistr_info(c);
+        if (info->has_unknown_chars ||
+            info->coverage() != FontInfo::UnistrInfo::Coverage::USE_PANGO_GLYPH_STRING)
+                return false;
+        auto const& glyphs = info->m_ufi.using_pango_glyph_string;
+        if (!glyphs.font || !glyphs.glyph_string->num_glyphs)
+                return false;
+        PangoRectangle ink;
+        pango_glyph_string_extents(glyphs.glyph_string, glyphs.font, &ink, nullptr);
+        // The advance can include large side bearings in a fallback font.
+        // Fit visible ink, rather than shrinking it to preserve unused spacing.
+        metrics = {ink.x / double(PANGO_SCALE),
+                   (ink.x + ink.width) / double(PANGO_SCALE),
+                   ink.y / double(PANGO_SCALE),
+                   (ink.y + ink.height) / double(PANGO_SCALE), private_use};
+        return metrics.right > metrics.left;
+}
+#endif
