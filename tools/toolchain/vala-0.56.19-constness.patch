--- /dev/null
+++ b/vala/vala-system-dirs.h
@@ -0,0 +1,12 @@
+/* Keep GLib's immutable directory vector borrowed; own only the copy. */
+#pragma once
+#include <glib.h>
+
+static inline gchar **vala_system_data_dirs_copy(void) {
+    const gchar * const *directories = g_get_system_data_dirs();
+    gsize length = 0;
+    while (directories[length]) length++;
+    gchar **copy = g_new0(gchar *, length + 1);
+    for (gsize i = 0; i < length; i++) copy[i] = g_strdup(directories[i]);
+    return copy;
+}
